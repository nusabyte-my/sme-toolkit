# Copy this file to .env and fill in your keys
# Required: at minimum GEMINI_API_KEY for AI features

# AI Provider Keys
GEMINI_API_KEY=
# Owner/Ads Studio: configurable current models; account access and billing required
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Optional: executable path; default uses ffmpeg on PATH for MP4 export
FFMPEG_PATH=ffmpeg
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
FIQSTR_API_KEY=
FIQSTR_BASE_URL=https://core.fiqstr.my.id/v1
FIQSTR_MODEL=fiqstr/deepseek-3.2
REPLICATE_API_KEY=
KLING_API_KEY=

# Database (default: SQLite; set to postgres for production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sme_toolkit

# JWT (generate via: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth user store (app/auth.py). Required — the app refuses to start without them
# when DEBUG=false. DEBUG=true falls back to legacy dev defaults (admin123 / n8n_webhook_secret).
ADMIN_PASSWORD=
N8N_PASSWORD=

# Agent channels: generate once with Python cryptography.fernet.Fernet.generate_key().
# Back up this key separately; changing it makes stored provider tokens unreadable.
CHANNEL_ENCRYPTION_KEY=
# Public HTTPS origin of this API, without a trailing path/query. Providers cannot reach localhost.
PUBLIC_WEBHOOK_BASE_URL=
WHATSAPP_API_VERSION=v23.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5340,http://127.0.0.1:5340

# App
DEBUG=true
LOG_LEVEL=INFO

# Internal evidence automations (each business must enable its own rules)
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_POLL_SECONDS=60

# Telegram/WhatsApp credentials are entered in the owner Channels UI and encrypted in the database.
# No credentials or client-selected billing tier are accepted from inbound messages.

# E-Commerce Integrations
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Courier Logistics Integration
JNT_API_KEY=
POSLAJU_API_KEY=
NINJAVAN_API_KEY=

# Payments (FPX & Stripe)
STRIPE_SECRET_KEY=
FPX_MERCHANT_ID=

